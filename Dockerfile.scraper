FROM mcr.microsoft.com/playwright/python:v1.49.0-jammy

# x11vnc + noVNC для доступу до браузера через веб-браузер (CAPTCHA)
RUN apt-get update && apt-get install -y --no-install-recommends \
    x11vnc \
    novnc \
    websockify \
    && rm -rf /var/lib/apt/lists/*

# Flask для API та requests для взаємодії
RUN pip install --no-cache-dir flask requests

WORKDIR /app
COPY scraper/ /app/
COPY docker/scraper_worker.py /app/worker.py
COPY docker/scraper_start.sh /start.sh
RUN chmod +x /start.sh

# Playwright Chromium вже в образі — встановлюємо браузер
RUN playwright install chromium

CMD ["/start.sh"]
