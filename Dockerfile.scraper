FROM mcr.microsoft.com/playwright/python:v1.49.0-jammy

# Вимикаємо інтерактивні підказки apt (tzdata тощо)
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Berlin

# x11vnc + noVNC для доступу до браузера через веб-браузер (CAPTCHA)
RUN apt-get update && apt-get install -y --no-install-recommends \
    x11vnc \
    novnc \
    websockify \
    tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

# Flask для API, requests, та playwright Python-пакет
RUN pip install --no-cache-dir flask requests playwright==1.49.0

WORKDIR /app
COPY scraper/ /app/
COPY docker/scraper_worker.py /app/worker.py
COPY docker/scraper_start.sh /start.sh
RUN chmod +x /start.sh

# Встановити Chromium через playwright (браузери в базовому образі вже є, але потрібен Python-пакет)
RUN python -m playwright install chromium

CMD ["/start.sh"]
