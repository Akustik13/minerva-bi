{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sevskiy.com/rag/v2/retrieval.response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "source_instance_id",
    "generation",
    "user_id",
    "status",
    "hits",
    "took_ms",
    "index",
    "warnings"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/contract_version"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/request_id"
    },
    "source_instance_id": {
      "$ref": "common.schema.json#/$defs/source_instance_id"
    },
    "generation": {
      "$ref": "common.schema.json#/$defs/generation"
    },
    "user_id": {
      "$ref": "common.schema.json#/$defs/pk"
    },
    "status": {
      "const": "completed"
    },
    "hits": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/hit"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "took_ms": {
      "type": "integer",
      "minimum": 0
    },
    "index": {
      "$ref": "common.schema.json#/$defs/index"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "index_stale",
              "text_truncated",
              "partial_index",
              "reranker_unavailable"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      },
      "minItems": 0,
      "maxItems": 20
    }
  }
}
