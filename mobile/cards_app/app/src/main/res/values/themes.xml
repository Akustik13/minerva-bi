<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MinervaCards" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorTertiary">@color/ok</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <style name="Theme.MinervaCards.Photo" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="CamChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/scrim</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>
</resources>
