<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MinervaCards" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorTertiary">@color/ok</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <style name="Theme.MinervaCards.Photo" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="CamChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/scrim</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <!-- режим камери: одна з чотирьох кнопок у смузі над ⭕ -->
    <style name="CamMode">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="CamLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowRadius">3</item>
    </style>
</resources>
